**Cover gradient generation from primary_color:**
```python
from colorsys import rgb_to_hls, hls_to_rgb

def darken(hex_color, factor):
    """Darken a hex color by factor (0.0=black, 1.0=unchanged)."""
    r, g, b = int(hex_color[1:3],16)/255, int(hex_color[3:5],16)/255, int(hex_color[5:7],16)/255
    h, l, s = rgb_to_hls(r, g, b)
    l = max(0, l * factor)
    r2, g2, b2 = hls_to_rgb(h, l, s)
    return f"#{int(r2*255):02x}{int(g2*255):02x}{int(b2*255):02x}"

gradient_stops = [
    (0.0, darken(primary_color, 0.85)),   # Top: slightly darkened
    (0.4, primary_color),                  # Middle: full brand color
    (0.7, darken(primary_color, 0.70)),   # Lower: darker
    (1.0, darken(primary_color, 0.50)),   # Bottom: darkest
]
```

