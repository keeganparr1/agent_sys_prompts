## COMPONENT: GradientCoverPage (full-page gradient -- copy exactly)

**v21: Full-page gradient.** The gradient fills the ENTIRE page top-to-bottom (not just a 280pt header band). All text sits on the dark gradient in white or accent_color. The old partial-banner layout is deprecated.

```python
class GradientCoverPage(Flowable):
    GRADIENT_STOPS = [
        (0.00, HexColor("#111111")),
        (0.33, HexColor("#1A1A1A")),
        (0.66, HexColor("#222222")),
        (1.00, HexColor("#0D0D0D")),
    ]

    def __init__(self, title, subtitle="", report_type="", summary_text="",
                 metrics=None, logo_path=None, confidential_label="CONFIDENTIAL",
                 footer_left="", footer_right="",
                 accent_color=HexColor("#FFFFFF"),
                 # Legacy compat params (accepted but ignored)
                 metadata=None, header_bg_path=None, page_width=None, page_height=None,
                 custom_logo_text=None):
        Flowable.__init__(self)
        self.title = title
        self.subtitle = subtitle
        self.report_type = report_type        # e.g. "SECURITY ASSESSMENT" -- shown as small accent label
        self.summary_text = summary_text      # 1-2 sentence muted paragraph below title
        self.metrics = metrics or []          # list of {value, label, sub} dicts for metric_columns()
        self.logo_path = logo_path
        self.confidential_label = confidential_label
        self.footer_left = footer_left        # e.g. "Prepared by ProjectDiscovery"
        self.footer_right = footer_right      # e.g. "September 2026"
        self.custom_logo_text = custom_logo_text
        self.accent_color = accent_color
        self.pw = page_width or letter[0]
        self.ph = page_height or letter[1]
        if metadata is not None:
            warnings.warn("GradientCoverPage: 'metadata' param is accepted for API compat but not rendered", stacklevel=2)
        if header_bg_path is not None:
            warnings.warn("GradientCoverPage: 'header_bg_path' param is accepted for API compat but not rendered", stacklevel=2)

    def wrap(self, availWidth, availHeight):
        return self.pw, self.ph

    def _interpolate_color(self, t):
        stops = self.GRADIENT_STOPS
        for i in range(len(stops) - 1):
            t0, c0 = stops[i]
            t1, c1 = stops[i + 1]
            if t0 <= t <= t1:
                frac = (t - t0) / (t1 - t0) if t1 != t0 else 0
                return Color(
                    c0.red   + (c1.red   - c0.red)   * frac,
                    c0.green + (c1.green - c0.green) * frac,
                    c0.blue  + (c1.blue  - c0.blue)  * frac,
                )
        return stops[-1][1]

    def draw(self):
        c = self.canv
        c.saveState()

        # 1. Full-page gradient (top=dark grey, bottom=darkest grey)
        num_strips = 120
        strip_h = self.ph / num_strips
        for i in range(num_strips):
            t = 1.0 - (i / (num_strips - 1))   # t=1.0 at top, t=0.0 at bottom
            c.setFillColor(self._interpolate_color(t))
            c.rect(0, i * strip_h, self.pw, strip_h + 1, fill=1, stroke=0)

        left_margin = MARGIN

        # 2. Logo (top-left, 44pt from top)
        logo_y = self.ph - 44
        logo_x = 36
        c.saveState()
        if self.custom_logo_text:
            c.setFont("PublicSans-Bold", 20)
            c.setFillColor(HexColor("#FFFFFF"))
            c.drawString(logo_x, logo_y, self.custom_logo_text)
        else:
            c.setFont("YoungSerif", 20)
            c.setFillColor(HexColor("#FFFFFF"))
            c.drawString(logo_x, logo_y, "neo")
            neo_w = c.stringWidth("neo", "YoungSerif", 20)
            c.setFont("PublicSans", 11)
            c.setFillColor(Color(1, 1, 1, alpha=0.55))
            c.drawString(logo_x + neo_w + 6, logo_y + 2, "by Projectdiscovery")
        c.restoreState()

        # 3. CONFIDENTIAL label (top-right)
        if self.confidential_label:
            c.saveState()
            c.setFont("PublicSans-Bold", 8)
            c.setFillColor(Color(1, 1, 1, alpha=0.40))
            c.drawRightString(self.pw - 36, logo_y + 4, self.confidential_label.upper())
            c.restoreState()

        # 4. Report type label (accent color, uppercase, 9pt)
        content_y = self.ph - 120
        if self.report_type:
            c.saveState()
            c.setFont("PublicSans-Bold", 9)
            c.setFillColor(self.accent_color)
            c.drawString(left_margin, content_y, self.report_type.upper())
            c.restoreState()
            content_y -= 28

        # 5. Main title (large bold white, 32pt, word-wrapped)
        content_y -= 8
        c.setFont("PublicSans-Bold", 32)
        c.setFillColor(HexColor("#FFFFFF"))
        max_title_w = self.pw - 2 * left_margin
        title_words = self.title.split()
        title_lines = []
        cur = ""
        for word in title_words:
            test = cur + " " + word if cur else word
            if c.stringWidth(test, "PublicSans-Bold", 32) > max_title_w:
                title_lines.append(cur)
                cur = word
            else:
                cur = test
        if cur:
            title_lines.append(cur)
        for line in title_lines:
            c.drawString(left_margin, content_y, line)
            content_y -= 42

        # 6. Subtitle / client name (16pt, 75% white)
        if self.subtitle:
            content_y -= 4
            c.setFont("PublicSans", 16)
            c.setFillColor(Color(1, 1, 1, alpha=0.75))
            c.drawString(left_margin, content_y, self.subtitle)
            content_y -= 30

        # 7. Summary paragraph (10pt, 65% white, word-wrapped at 68% page width)
        if self.summary_text:
            content_y -= 8
            c.setFont("PublicSans", 10)
            c.setFillColor(Color(1, 1, 1, alpha=0.65))
            max_sum_w = self.pw * 0.68
            s_words = self.summary_text.split()
            s_lines = []
            cl = ""
            for w in s_words:
                test = cl + " " + w if cl else w
                if c.stringWidth(test, "PublicSans", 10) > max_sum_w:
                    s_lines.append(cl)
                    cl = w
                else:
                    cl = test
            if cl:
                s_lines.append(cl)
            for line in s_lines:
                c.drawString(left_margin, content_y, line)
                content_y -= 16

        # 8. Thin accent rule above metrics (accent_color, 60% page width)
        metrics_area_top = 230
        rule_y = metrics_area_top + (70 if self.metrics else 0) + 18
        c.saveState()
        c.setStrokeColor(self.accent_color)
        c.setLineWidth(1)
        c.line(left_margin, rule_y, left_margin + self.pw * 0.60, rule_y)
        c.restoreState()

        # 9. metric_columns() KPI grid (draws near bottom of page)
        if self.metrics:
            grid = metric_columns(self.metrics)
            gw, gh = grid.wrap(DOC_WIDTH, 180)
            grid.drawOn(c, left_margin, metrics_area_top - gh + 20)

        # 10. Footer text at very bottom (7.5pt, 40% white)
        c.saveState()
        c.setFont("PublicSans", 8)
        c.setFillColor(Color(1, 1, 1, alpha=0.40))
        if self.footer_left:
            c.drawString(left_margin, 30, self.footer_left)
        if self.footer_right:
            c.drawRightString(self.pw - left_margin, 30, self.footer_right)
        c.restoreState()

        c.restoreState()
```

**NOTE (v22 params):**
- `report_type`: Small bold label above the title (e.g. "SECURITY ASSESSMENT"). Color is `accent_color` (defaults to white for Neo; pass brand color for branded reports).
- `accent_color`: Brand accent color for **decorative elements only** — the report_type label and the thin accent rule line. Defaults to white (`HexColor("#FFFFFF")`). For branded reports, pass the brand's primary color. **metric_columns() value text color is computed separately** — it always uses `TEXT_ON_BRAND` (white on dark gradients, dark on light) for readability. Never pass raw brand color as metric value text.
- `summary_text`: 1-2 sentence muted white paragraph below title/subtitle.
- `metrics`: List of `{"value": "5", "label": "Critical", "sub": "All exploitable"}` dicts rendered via `metric_columns()`.
- `footer_left` / `footer_right`: Tiny muted text at the very bottom edge.
- Legacy params `metadata`, `header_bg_path` are accepted for API compat; `warnings.warn()` is emitted when they are passed.
- The unified `draw_footer` callback still fires via `onPageEnd` on the page template.

