**Contrast Logic — luminance check:**
```python
def is_light_color(hex_color):
    """Returns True if color is light (needs dark text on top)."""
    r, g, b = int(hex_color[1:3],16), int(hex_color[3:5],16), int(hex_color[5:7],16)
    luminance = (0.299*r + 0.587*g + 0.114*b) / 255
    return luminance > 0.55

text_on_brand = "#1A1A1A" if is_light_color(BRAND_CONFIG["primary_color"]) else "#FFFFFF"

# ── Contrast safety (WCAG 2.0) ──
def contrast_ratio(fg_hex, bg_hex):
    """WCAG 2.0 relative luminance contrast ratio. Returns float >= 1.0."""
    def rel_lum(h):
        r, g, b = int(h[1:3],16)/255, int(h[3:5],16)/255, int(h[5:7],16)/255
        r = r/12.92 if r <= 0.04045 else ((r+0.055)/1.055)**2.4
        g = g/12.92 if g <= 0.04045 else ((g+0.055)/1.055)**2.4
        b = b/12.92 if b <= 0.04045 else ((b+0.055)/1.055)**2.4
        return 0.2126*r + 0.7152*g + 0.0722*b
    l1, l2 = rel_lum(fg_hex), rel_lum(bg_hex)
    lighter, darker = max(l1,l2), min(l1,l2)
    return (lighter + 0.05) / (darker + 0.05)

def assert_readable(fg_hex, bg_hex, context="text"):
    """Raise ValueError if contrast ratio is below WCAG AA threshold.
    context='large' uses 3:1 (36pt+ bold text), else 4.5:1."""
    ratio = contrast_ratio(fg_hex, bg_hex)
    threshold = 3.0 if context == "large" else 4.5
    if ratio < threshold:
        raise ValueError(
            f"CONTRAST FAIL: {fg_hex} on {bg_hex} = {ratio:.1f}:1 "
            f"(need {threshold}:1 for {context}). "
            f"Use '#FFFFFF' on dark or '#1A1A1A' on light."
        )
```

