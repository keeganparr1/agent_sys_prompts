## COMPONENT: TOC Engine — MyDocTemplate + TableOfContents (copy exactly)

**This replaces manual TOC tables. ReportLab's built-in TableOfContents automatically
captures page numbers via a two-pass build (multiBuild). Headings are detected by
their paragraph style name and registered as TOC entries + PDF bookmarks automatically.**

```python
# ── TOC level mapping: paragraph style name → TOC indent level ──
# H1 = top-level section (level 0), H2 = subsection (level 1), H3 = sub-subsection (level 2)
HEADING_TOC_LEVELS = {'H1': 0, 'H2': 1, 'H3': 2}

class MyDocTemplate(BaseDocTemplate):
    """Extended BaseDocTemplate that auto-captures heading page numbers for TOC."""
    def __init__(self, *args, **kwargs):
        BaseDocTemplate.__init__(self, *args, **kwargs)
        self._heading_count = 0

    def beforeDocument(self):
        """Reset heading counter at start of each build pass (needed for multiBuild)."""
        self._heading_count = 0

    def afterFlowable(self, flowable):
        """After each flowable, check if it's a heading and register it with the TOC."""
        if isinstance(flowable, Paragraph):
            style_name = flowable.style.name
            if style_name in HEADING_TOC_LEVELS:
                self._heading_count += 1
                text = flowable.getPlainText()
                level = HEADING_TOC_LEVELS[style_name]
                key = f'section-{self._heading_count}'
                # Notify TableOfContents of this entry (level, text, pageNum, key)
                self.notify('TOCEntry', (level, text, self.page, key))
                # Create PDF bookmark for clickable navigation
                self.canv.bookmarkPage(key)
                self.canv.addOutlineEntry(text, key, level=level)

# ── TOC Flowable Styles ──
# Level 0 (H1): bold, full-width, with dot leaders to page number
# Level 1 (H2): regular, indented 20pt, with dot leaders
# Level 2 (H3): regular, indented 40pt, with dot leaders
TOC_LEVEL_STYLES = [
    ParagraphStyle(name='TOC1', fontName='PublicSans-Bold', fontSize=11,
                   leftIndent=0, textColor=HexColor("#1A1A2E"),
                   spaceBefore=6, spaceAfter=2, endDots=' . '),
    ParagraphStyle(name='TOC2', fontName='PublicSans', fontSize=10,
                   leftIndent=20, textColor=HexColor("#555555"),
                   spaceBefore=2, spaceAfter=2, endDots=' . '),
    ParagraphStyle(name='TOC3', fontName='PublicSans', fontSize=9,
                   leftIndent=40, textColor=HexColor("#777777"),
                   spaceBefore=1, spaceAfter=1, endDots=' . '),
]
```

