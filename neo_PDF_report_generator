## COMPONENT: MetricCard (copy exactly)

Use for 2-6 key metric values. NEVER use a table for metrics.

```python
class MetricCard(Flowable):
    def __init__(self, value, label, width=None, height=70, radius=8, accent_color=HexColor("#0066CC"), bg_color=None):
        Flowable.__init__(self)
        self.value = str(value)
        self.label = label
        self.card_width = width
        self.card_height = height
        self.radius = radius
        self.accent_color = accent_color
        self.bg_color = bg_color if bg_color is not None else HexColor("#F7F8FA")
        self.border_color = HexColor("#E5E7EB")
    def wrap(self, availWidth, availHeight):
        if self.card_width is None:
            self.card_width = availWidth
        return self.card_width, self.card_height
    def draw(self):
        c = self.canv
        c.saveState()
        c.setFillColor(self.bg_color)
        c.setStrokeColor(self.border_color)
        c.setLineWidth(0.75)
        c.roundRect(0, 0, self.card_width, self.card_height, self.radius, fill=1, stroke=1)
        # (removed colored top accent bar — background fill is sufficient)
        c.setFont("PublicSans-Bold", 22)
        c.setFillColor(HexColor("#0D0D0D"))
        c.drawCentredString(self.card_width / 2, self.card_height / 2 + 2, self.value)
        c.setFont("PublicSans", 9)
        c.setFillColor(TEXT_BODY)
        c.drawCentredString(self.card_width / 2, self.card_height / 2 - 16, self.label)
        c.restoreState()

def metric_cards(metrics, accent_color=HexColor("#0066CC")):
    count = len(metrics)
    gap = 10
    available = DOC_WIDTH - (gap * (count - 1))
    card_w = available / count
    cards = []
    for item in metrics:
        if len(item) == 4: v, l, ac, bg = item
        elif len(item) == 3: v, l, ac = item; bg = None
        else: v, l = item; ac = accent_color; bg = None
        cards.append(MetricCard(v, l, width=card_w, accent_color=ac, bg_color=bg))
    t = Table([cards], colWidths=[card_w + gap] * (count - 1) + [card_w])
    t.setStyle(TableStyle([("ALIGN",(0,0),(-1,-1),"CENTER"),("VALIGN",(0,0),(-1,-1),"MIDDLE"),("LEFTPADDING",(0,0),(-1,-1),0),("RIGHTPADDING",(0,0),(-1,-1),0),("TOPPADDING",(0,0),(-1,-1),0),("BOTTOMPADDING",(0,0),(-1,-1),0)]))
    return t
