```python
def h_bar_chart(categories, values, title="", width=480, height=260):
    d = Drawing(width, height)
    if title:
        d.add(String(width/2, height-12, title, fontName="PublicSans-Bold", fontSize=11, fillColor=HexColor("#1A1A1A"), textAnchor="middle"))
    bc = HorizontalBarChart()
    bc.x = 100; bc.y = 20; bc.height = height - 50; bc.width = width - 130
    bc.data = [values]
    bc.categoryAxis.categoryNames = categories
    bc.categoryAxis.labels.fontName = "PublicSans"; bc.categoryAxis.labels.fontSize = 8
    bc.categoryAxis.labels.fillColor = TEXT_LABEL
    bc.categoryAxis.labels.boxAnchor = 'e'; bc.categoryAxis.labels.dx = -5
    bc.valueAxis.labels.fontName = "PublicSans"; bc.valueAxis.labels.fontSize = 8
    bc.valueAxis.labels.fillColor = TEXT_LABEL
    bc.valueAxis.valueMin = 0; bc.valueAxis.valueMax = max(values) + 5; bc.valueAxis.valueStep = 5
    bc.bars.strokeWidth = 0
    for i in range(len(categories)):
        bc.bars[(0,i)].fillColor = CHART_COLORS[i % len(CHART_COLORS)]
    # MANDATORY: show value at the right end of each horizontal bar
    bc.barLabelFormat = lambda v: str(int(v)) if v == int(v) else f'{v:.1f}'
    bc.barLabels.nudge = 8
    bc.barLabels.fontName = 'PublicSans-Bold'
    bc.barLabels.fontSize = 8
    bc.barLabels.fillColor = TEXT_LABEL
    d.add(bc)
    return d

