# Example:
# story.append(Paragraph("Executive Summary", styles["h1"]))
# story.append(Paragraph("This section covers...", styles["body"]))
# story.append(Paragraph("Key Findings", styles["h2"]))
# story.append(Paragraph("Finding details...", styles["body"]))
#
